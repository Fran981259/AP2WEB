# Public DNS name that resolves to this host. Do not include https://.
AP2WEB_PUBLIC_DOMAIN=app.example.com

# Immutable image tag published by CI. Never use latest for a production deploy.
AP2WEB_IMAGE=ghcr.io/fran981259/ap2web:<git-sha>

# External Docker Swarm secret names. Version the names when rotating values.
AP2WEB_SECRET_NAME=ap2web_secret_v1
AP2WEB_DATABASE_URL_SECRET_NAME=ap2web_database_url_v1
AP2WEB_POSTGRES_PASSWORD_SECRET_NAME=ap2web_postgres_password_v1
