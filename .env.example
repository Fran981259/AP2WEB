# Configuração do AP2WEB (copie para .env ou exporte no shell)

# Origens permitidas (CORS) — separadas por vírgula.
# Em produção, coloque seu domínio:
AP2WEB_ORIGINS=https://meudominio.com

# Chave secreta para JWT (troque por um valor aleatório em produção)
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
AP2WEB_SECRET=troque-esta-chave-por-um-valor-aleatorio-de-64-caracteres

# Porta do servidor (padrão 8000)
PORT=8000